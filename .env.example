# Copy to .env and fill in. Never commit .env (enforced by .claude/hooks/check-env-edit.sh
# and check-git-secrets.sh).

# --- Nango (Gmail attachment ingestion) ---
NANGO_SECRET_KEY=
NANGO_CONNECTION_ID=
NANGO_INTEGRATION_ID=google-mail

# --- Respan (routes stage-4 extract + stage-5 cross-check calls) ---
RESPAN_API_KEY=
RESPAN_PROJECT_ID=

# --- Lambda (hosts the stage-5 larger Gemma checkpoint) ---
LAMBDA_API_KEY=
LAMBDA_ENDPOINT_URL=

# --- Local paths ---
PHOTOS_DIR=./ingest/staging/photos
GMAIL_STAGING_DIR=./ingest/staging/gmail
DB_PATH=./api/retrace.db

# --- Stage 4 local model (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=gemma3:4b
